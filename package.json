{
  "id": "org.mass4.turian.ddd.studio",
  "version": "1.0.0",
  "displayName": "DataAsset-Driven Design Studio",
  "description": "Asset creation, live values, event tracing and wire validation.",
  "author": "MASS4",
  "license": "MPL-2.0",
  "scopes": ["studio"],
  "categories": ["turian:editor"],
  "dependencies": {
    "org.mass4.turian.ddd": "^1.0.0"
  },
  "roles": {
    "source": "Brick~/Source",
    "tests": "Brick~/Tests",
    "precast": "Brick~/Precast"
  },
  "exclude": [
    "Brick~/Tests",
    ".github",
    ".gitignore",
    ".local",
    ".script-*.py",
    ".script-*.cs",
    ".script-*.sh",
    ".script-*.ps1"
  ],
  "bake": "auto"
}
